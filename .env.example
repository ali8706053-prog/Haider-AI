# -----------------------------------------------------------------------------
# RINGWELL AI — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file to .env.local when you are ready to configure live production services:
# cp .env.example .env.local

# -----------------------------------------------------------------------------
# WEBSITE & PRODUCTION DOMAIN (Required for SEO, Canonical URLs, Sitemaps)
# e.g., https://ringwellai.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://ringwellai.com"

# -----------------------------------------------------------------------------
# GOOGLE ANALYTICS 4 (Optional - disabled if left blank)
# e.g., G-XXXXXXXXXX
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# -----------------------------------------------------------------------------
# RETELL AI VOICE ENGINE (Optional - for live browser calls / phone agent)
# Docs: https://docs.retellai.com
# -----------------------------------------------------------------------------
RETELL_API_KEY=""
RETELL_AGENT_ID=""

# -----------------------------------------------------------------------------
# CRM & WORKFLOW AUTOMATIONS (Optional - Webhook endpoint)
# e.g., Make.com webhook URL, Zapier webhook, or GoHighLevel Inbound Webhook
# -----------------------------------------------------------------------------
CRM_WEBHOOK_URL=""

# -----------------------------------------------------------------------------
# ONLINE CALENDAR / APPOINTMENT BOOKING (Optional)
# e.g. Cal.com link (https://cal.com/your-name/demo) or Calendly link
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BOOKING_URL=""
